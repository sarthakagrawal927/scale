{
  "name": "scale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "measure": "node scripts/measure.mjs",
    "format": "prettier --write src/App.tsx src/styles.css src/main.tsx src/game scripts *.json *.md vite.config.ts",
    "format:check": "prettier --check src/App.tsx src/styles.css src/main.tsx src/game scripts *.json *.md vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
